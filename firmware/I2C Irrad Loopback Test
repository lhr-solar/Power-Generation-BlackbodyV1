/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
  /* USER CODE BEGIN 1 */
  HAL_StatusTypeDef ret;
  uint8_t id = 0;
  uint8_t status = 0;
  uint8_t d[4];
  /* USER CODE END 1 */

  HAL_Init();
  SystemClock_Config();

  MX_GPIO_Init();
  MX_USART2_UART_Init();
  MX_I2C1_Init();

  /* USER CODE BEGIN 2 */
  uart_print("\r\n=== TSL25911FN I2C Test ===\r\n");

  /* Basic ACK check once up front */
  ret = HAL_I2C_IsDeviceReady(&hi2c1, TSL2591_ADDR_8BIT, 3, 100);
  if (ret != HAL_OK)
  {
    uart_printf("NO ACK at 0x%02X (check power, SDA/SCL, pullups, address)\r\n",
                (unsigned int)(TSL2591_ADDR_8BIT >> 1));
  }
  else
  {
    uart_printf("ACK OK at 0x%02X\r\n", (unsigned int)(TSL2591_ADDR_8BIT >> 1));
  }

  /* Read and print ID (expected 0x50) */
  ret = tsl_read8(REG_ID, &id);
  if (ret != HAL_OK)
  {
    uart_print("Failed to read ID register\r\n");
  }
  else
  {
    uart_printf("ID = 0x%02X (expected 0x50)\r\n", (unsigned int)id);
  }

  /* One-time init (ENABLE + CONTROL) */
  ret = tsl_init_once();
  if (ret != HAL_OK)
  {
    uart_print("TSL init failed (ENABLE/CONTROL write)\r\n");
  }
  else
  {
    uart_print("TSL init OK\r\n");
  }
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* Keep checking device presence; if it ever disappears, report it */
    ret = HAL_I2C_IsDeviceReady(&hi2c1, TSL2591_ADDR_8BIT, 1, 50);
    if (ret != HAL_OK)
    {
      uart_print("NO ACK (device missing?)\r\n");
      HAL_Delay(500);
      continue;
    }

    /* Read STATUS (AVALID indicates fresh ALS data) */
    ret = tsl_read8(REG_STATUS, &status);
    if (ret != HAL_OK)
    {
      uart_print("Error reading STATUS\r\n");
      HAL_Delay(500);
      continue;
    }

    /* Read CH0 + CH1 as 4 bytes from 0x14..0x17 */
    ret = tsl_readN(REG_C0DATAL, d, 4);
    if (ret != HAL_OK)
    {
      uart_print("Error reading CH0/CH1\r\n");
      HAL_Delay(500);
      continue;
    }

    /* Little-endian assembly */
    uint16_t ch0 = (uint16_t)((uint16_t)d[0] | ((uint16_t)d[1] << 8));
    uint16_t ch1 = (uint16_t)((uint16_t)d[2] | ((uint16_t)d[3] << 8));

    /* Quick derived number: visible-ish counts */
    int32_t vis = (int32_t)ch0 - (int32_t)ch1;
    if (vis < 0) vis = 0;

    uart_printf("STATUS=0x%02X AVALID=%u | CH0=%u CH1=%u VIS=%ld\r\n",
                (unsigned int)status,
                (status & STATUS_AVALID) ? 1u : 0u,
                (unsigned int)ch0,
                (unsigned int)ch1,
                (long)vis);

    HAL_Delay(500);
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

