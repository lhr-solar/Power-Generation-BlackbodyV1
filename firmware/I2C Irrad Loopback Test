static void uart_print(const char *s)
{
  HAL_UART_Transmit(&huart2, (uint8_t*)s, (uint16_t)strlen(s), HAL_MAX_DELAY);
}

static void uart_printf(const char *fmt, ...)
{
  char out[160];
  va_list args;
  va_start(args, fmt);
  vsnprintf(out, sizeof(out), fmt, args);
  va_end(args);
  uart_print(out);
}

static inline uint8_t tsl_cmd(uint8_t reg)
{
  return (uint8_t)(CMD_NORMAL | (reg & 0x1Fu));
}

static HAL_StatusTypeDef tsl_write8(uint8_t reg, uint8_t val)
{
  uint8_t tx[2];
  tx[0] = tsl_cmd(reg);
  tx[1] = val;
  return HAL_I2C_Master_Transmit(&hi2c1, TSL2591_ADDR_8BIT, tx, 2, HAL_MAX_DELAY);
}

static HAL_StatusTypeDef tsl_read8(uint8_t reg, uint8_t *val)
{
  HAL_StatusTypeDef ret;
  uint8_t cmd = tsl_cmd(reg);

  ret = HAL_I2C_Master_Transmit(&hi2c1, TSL2591_ADDR_8BIT, &cmd, 1, HAL_MAX_DELAY);
  if (ret != HAL_OK) return ret;

  return HAL_I2C_Master_Receive(&hi2c1, TSL2591_ADDR_8BIT, val, 1, HAL_MAX_DELAY);
}

static HAL_StatusTypeDef tsl_readN(uint8_t startReg, uint8_t *buf, uint16_t len)
{
  HAL_StatusTypeDef ret;
  uint8_t cmd = tsl_cmd(startReg);

  ret = HAL_I2C_Master_Transmit(&hi2c1, TSL2591_ADDR_8BIT, &cmd, 1, HAL_MAX_DELAY);
  if (ret != HAL_OK) return ret;

  return HAL_I2C_Master_Receive(&hi2c1, TSL2591_ADDR_8BIT, buf, len, HAL_MAX_DELAY);
}

static HAL_StatusTypeDef tsl_init_once(void)
{
  HAL_StatusTypeDef ret;

  /* 1) Power on oscillator */
  ret = tsl_write8(REG_ENABLE, ENABLE_PON);
  if (ret != HAL_OK) return ret;
  HAL_Delay(5);

  /* 2) Enable ALS engine */
  ret = tsl_write8(REG_ENABLE, (uint8_t)(ENABLE_PON | ENABLE_AEN));
  if (ret != HAL_OK) return ret;

  /* 3) Set CONTROL (gain + integration time) */
  uint8_t control = (uint8_t)(TSL_DEFAULT_GAIN | TSL_DEFAULT_ATIME);
  ret = tsl_write8(REG_CONTROL, control);
  if (ret != HAL_OK) return ret;

  /* 4) Wait long enough for first conversion to become valid */
  HAL_Delay(TSL_INTEGRATION_DELAY_MS);

  g_tsl_initialized = 1;
  return HAL_OK;
}

