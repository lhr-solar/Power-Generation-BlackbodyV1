/* HAL uses 8-bit address = (7-bit << 1) */
#define TSL2591_ADDR_8BIT   (0x29u << 1)

/* Register map */
#define REG_ENABLE          0x00u
#define REG_CONTROL         0x01u
#define REG_ID              0x12u
#define REG_STATUS          0x13u
#define REG_C0DATAL         0x14u   /* CH0 low byte; read 4 bytes total */

/* ENABLE bits */
#define ENABLE_PON          (1u << 0)  /* power on oscillator */
#define ENABLE_AEN          (1u << 1)  /* ALS enable */

/* STATUS bits */
#define STATUS_AVALID       (1u << 0)  /* ALS valid flag */

/*
  COMMAND byte format for TSL2591:
    bit7 = 1 (CMD)
    bits6:5 = 01 (normal register access)
    bits4:0 = register address
  => base 0xA0, then OR with (reg & 0x1F)
*/
#define CMD_NORMAL          0xA0u

/* CONTROL bits (gain + integration time)
   AGAIN = bits5:4
   ATIME = bits2:0
*/
#define AGAIN_LOW           (0u << 4)
#define AGAIN_MED           (1u << 4)
#define AGAIN_HIGH          (2u << 4)
#define AGAIN_MAX           (3u << 4)

#define ATIME_100MS         (0u)
#define ATIME_200MS         (1u)
#define ATIME_300MS         (2u)
#define ATIME_400MS         (3u)
#define ATIME_500MS         (4u)
#define ATIME_600MS         (5u)

/* Pick bring-up defaults */
#define TSL_DEFAULT_GAIN    AGAIN_MED
#define TSL_DEFAULT_ATIME   ATIME_200MS

/* Match delay to integration time (+ margin) */
#define TSL_INTEGRATION_DELAY_MS  250u

