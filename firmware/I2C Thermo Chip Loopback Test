/**
  ******************************************************************************
  * @file           : main.c
  * @brief          : MCP96L00 I2C smoke test (loopback/alive check)
  ******************************************************************************
  * @attention
  *
  * This is a simple "is the device alive on I2C" test modeled after ST's
  * Getting started with I2C example.
  *
  * What it does every 500 ms:
  *   1) Checks if MCP96L00 responds (ACK) at address 0x60
  *   2) Reads 2 bytes from Hot Junction register (0x00)
  *   3) Converts to temperature (approx, 0.0625 C/LSB)
  *   4) Prints to UART2
  *
  * Notes:
  * - If you get NO ACK, try 0x61 if your address strap differs.
  * - This does not configure thermocouple type/filtering; it's just a bring-up test.
  ******************************************************************************
  */
/* USER CODE END Header */

/* Includes ------------------------------------------------------------------*/
#include "main.h"

/* Private includes ----------------------------------------------------------*/
/* USER CODE BEGIN Includes */
#include <string.h>
#include <stdio.h>
/* USER CODE END Includes */

/* Private typedef -----------------------------------------------------------*/
/* USER CODE BEGIN PTD */
/* USER CODE END PTD */

/* Private define ------------------------------------------------------------*/
/* USER CODE BEGIN PD */
#define MCP96L00_ADDR      (0x60 << 1)   // 8-bit I2C address for HAL (7-bit << 1)
#define MCP96L00_REG_HOTJ  (0x00)        // Hot Junction Temperature register
/* USER CODE END PD */

/* Private macro -------------------------------------------------------------*/
/* USER CODE BEGIN PM */
/* USER CODE END PM */

/* Private variables ---------------------------------------------------------*/
I2C_HandleTypeDef hi2c1;
UART_HandleTypeDef huart2;

/* USER CODE BEGIN PV */
static uint8_t reg = MCP96L00_REG_HOTJ;
/* USER CODE END PV */

/* Private function prototypes -----------------------------------------------*/
void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_USART2_UART_Init(void);
static void MX_I2C1_Init(void);
/* USER CODE BEGIN PFP */
/* USER CODE END PFP */

/* Private user code ---------------------------------------------------------*/
/* USER CODE BEGIN 0 */
/* USER CODE END 0 */

/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
  /* USER CODE BEGIN 1 */
  HAL_StatusTypeDef ret;
  uint8_t buf[32];
  uint8_t data[2];
  int16_t raw;
  float temp_c;
  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */
  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */
  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_USART2_UART_Init();
  MX_I2C1_Init();
  /* USER CODE BEGIN 2 */
  strcpy((char*)buf, "MCP96L00 I2C test start\r\n");
  HAL_UART_Transmit(&huart2, buf, strlen((char*)buf), HAL_MAX_DELAY);
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    // 0) Quick ACK check (device responds on the bus)
    ret = HAL_I2C_IsDeviceReady(&hi2c1, MCP96L00_ADDR, 3, 100);

    if (ret != HAL_OK)
    {
      // If you see this, wiring/address is wrong or device unpowered.
      // Try changing MCP96L00_ADDR to (0x61<<1) if the address strap is different.
      sprintf((char*)buf, "NO ACK @ 0x%02X\r\n", (unsigned int)(MCP96L00_ADDR >> 1));
      HAL_UART_Transmit(&huart2, buf, strlen((char*)buf), HAL_MAX_DELAY);
      HAL_Delay(500);
      continue;
    }

    // 1) Tell MCP96L00 which register we want to read (Hot Junction temp = 0x00)
    reg = MCP96L00_REG_HOTJ;
    ret = HAL_I2C_Master_Transmit(&hi2c1, MCP96L00_ADDR, &reg, 1, HAL_MAX_DELAY);

    if (ret != HAL_OK)
    {
      strcpy((char*)buf, "Error Tx (reg ptr)\r\n");
      HAL_UART_Transmit(&huart2, buf, strlen((char*)buf), HAL_MAX_DELAY);
      HAL_Delay(500);
      continue;
    }

    // 2) Read 2 bytes from the hot junction temperature register
    ret = HAL_I2C_Master_Receive(&hi2c1, MCP96L00_ADDR, data, 2, HAL_MAX_DELAY);

    if (ret != HAL_OK)
    {
      strcpy((char*)buf, "Error Rx (data)\r\n");
      HAL_UART_Transmit(&huart2, buf, strlen((char*)buf), HAL_MAX_DELAY);
      HAL_Delay(500);
      continue;
    }

    // 3) Combine bytes into signed 16-bit
    raw = (int16_t)((uint16_t)data[0] << 8 | (uint16_t)data[1]);

    // 4) Convert raw to Celsius (typical scaling is 0.0625 C/LSB)
    temp_c = (float)raw * 0.0625f;

    // 5) Print output (raw + temp)
    sprintf((char*)buf,
            "raw=0x%02X%02X (%d) temp=%.2f C\r\n",
            (unsigned int)data[0],
            (unsigned int)data[1],
            (int)raw,
            (double)temp_c);

    HAL_UART_Transmit(&huart2, buf, strlen((char*)buf), HAL_MAX_DELAY);

    // Wait
    HAL_Delay(500);

    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

