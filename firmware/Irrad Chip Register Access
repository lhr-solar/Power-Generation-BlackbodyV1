}

void irrad_read()  //Kell started editing code here
{
         // TSL2591 auto-increments register addresses internally
        static uint8_t adc_buf[4];

    HAL_I2C_Mem_Read_IT(
        &hi2c1,
        DEV_ADDR << 1, //STM32 wants 8-bit format so + 1 bit shift
        (0xA0 | C0DATAL),              // COMMAND byte + start register
        I2C_MEMADD_SIZE_8BIT,
        adc_buf,
        4
    );
}

void irrad_write()
{
                        // write to enable and control regs
        uint8_t msg = 0x03;            // ENABLE = PON | AEN

    HAL_I2C_Mem_Write_IT(
        &hi2c1,
        DEV_ADDR << 1,
        (0xA0 | ENABLE),  //writing to the enable register
        I2C_MEMADD_SIZE_8BIT,
        &msg,
        1
    );
}               // Kell stopped editing code here

